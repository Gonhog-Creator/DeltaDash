{
  "name": "ballistic-analytics-platform",
  "version": "1.0.0",
  "description": "Ballistic Test Analytics & Prediction Platform",
  "scripts": {
    "install": "npm run install:backend && npm run install:frontend",
    "install:backend": "cd backend && python3 -m pip install -r requirements.txt",
    "install:frontend": "cd frontend && npm install",
    "dev": "npm run dev:postgres && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:postgres": "node scripts/ensure-postgres.js",
    "dev:backend": "node scripts/start-backend.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "migrate": "node scripts/migrate.js",
    "stop": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "ballistic",
    "analytics",
    "react",
    "fastapi",
    "typescript"
  ],
  "author": "Ballistics Team",
  "license": "MIT"
}
